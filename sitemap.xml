---
layout: null
# Se genera solo: páginas fijas, secciones y todos los artículos.
# Si cambias una página fija (generador, medidor…), actualiza aquí su fecha.
fijas:
  - { url: /generador.html, lastmod: 2026-11-11 }
  - { url: /medidor.html, lastmod: 2026-11-11 }
  - { url: /aviso-legal.html, lastmod: 2026-11-11 }
  - { url: /privacidad.html, lastmod: 2026-11-11 }
---
{%- assign dc = site.data.dc -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ site.url }}/</loc><lastmod>{{ dc.ultima }}</lastmod></url>
{%- for f in page.fijas %}
  <url><loc>{{ site.url }}{{ f.url }}</loc><lastmod>{{ f.lastmod }}</lastmod></url>
{%- endfor %}
  <url><loc>{{ site.url }}/articulos/</loc><lastmod>{{ dc.ultima }}</lastmod></url>
{%- for s in dc.secciones %}
  <url><loc>{{ site.url }}{{ s.url }}</loc><lastmod>{{ dc.ultima }}</lastmod></url>
{%- for a in s.articulos %}
  <url><loc>{{ site.url }}{{ a.url }}</loc><lastmod>{{ a.actualizado }}</lastmod></url>
{%- endfor %}
{%- endfor %}
</urlset>
